# Terraform working directory and downloaded providers
.terraform/

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform plans and crash logs
*.zip
*.tfplan
*.plan
crash.log
crash.*.log

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Existing local Terraform executable ignore rule
./terraform
