// Lab 2 - CI pipeline for the vProfile app.
// Commit this file to the repo root of the app project as `Jenkinsfile`.
//
// Credentials referenced here are IDs from Manage Jenkins > Credentials.
// No password, token or URL-with-embedded-auth ever appears in this file.

pipeline {
    agent any

    tools {
        jdk   'JDK11'    // must match the name you configured in Manage Jenkins > Tools
        maven 'MAVEN3'
    }

    environment {
        NEXUS_URL   = "${env.NEXUS_HOST}"          // set as a Jenkins global env var
        NEXUS_CREDS = credentials('nexus-login')   // injects USR and PSW, masked in logs
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build') {
            steps { sh 'mvn -B -DskipTests clean install' }
            post {
                success {
                    echo 'Archiving the artifact so later stages and humans can find it'
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Unit Tests') {
            steps { sh 'mvn -B test' }
            post { always { junit '**/target/surefire-reports/*.xml' } }
        }

        stage('Checkstyle') {
            steps { sh 'mvn -B checkstyle:checkstyle' }
        }

        stage('Code Analysis') {
            steps {
                withSonarQubeEnv('sonarserver') {
                    sh '''mvn -B sonar:sonar \
                          -Dsonar.projectKey=vprofile \
                          -Dsonar.projectName=vprofile'''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                // Blocks until SonarQube calls back via its webhook.
                // If this hangs forever, the webhook in SonarQube is missing or wrong.
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                nexusArtifactUploader(
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    nexusUrl: "${NEXUS_URL}",
                    groupId: 'com.visualpathit',
                    version: "${env.BUILD_ID}-${env.BUILD_TIMESTAMP}",
                    repository: 'vprofile-release',
                    credentialsId: 'nexus-login',
                    artifacts: [[artifactId: 'vproapp',
                                 classifier: '',
                                 file: 'target/vprofile-v2.war',
                                 type: 'war']]
                )
            }
        }
    }

    post {
        success { slackSend channel: '#devops-ci', color: 'good',
                            message: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})" }
        failure { slackSend channel: '#devops-ci', color: 'danger',
                            message: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})" }
        always  { cleanWs() }
    }
}
